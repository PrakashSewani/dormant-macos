<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}">
    <link rel="stylesheet" href="styles.css">
    <link rel="icon" href="favicon.svg" type="image/svg+xml">
    <link rel="icon" href="favicon-32.png" sizes="32x32" type="image/png">
    <link rel="apple-touch-icon" href="apple-touch-icon.png">
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="./">Dormant</a>
      <nav aria-label="Site">
        <a href="#moves">How it works</a>
        <a href="#rules">Safety</a>
        <a href="https://github.com/PrakashSewani/dormant-macos">GitHub</a>
      </nav>
    </header>
    <main id="main">
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      <p class="footer-promise">Dormant is local-first. Your projects never leave this Mac: no account, no telemetry, no server.</p>
      <nav aria-label="Footer">
        <a href="https://github.com/PrakashSewani/dormant-macos">Source</a>
        <a href="https://github.com/PrakashSewani/dormant-macos/releases">Releases</a>
      </nav>
      <p class="footer-fine">macOS 26 or later. Free.</p>
    </footer>
  </body>
  <script>
    document.querySelectorAll(".install-block").forEach(function (block) {
      var button = block.querySelector(".copy-button");
      var code = block.querySelector("code");
      if (!button || !code) return;
      button.addEventListener("click", function () {
        navigator.clipboard.writeText(code.textContent.trim()).then(function () {
          button.textContent = "Copied";
          setTimeout(function () { button.textContent = "Copy"; }, 1500);
        });
      });
    });
  </script>
</html>
